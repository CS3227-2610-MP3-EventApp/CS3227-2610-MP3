# Local development only; match the port shown by docker compose ps.
DATABASE_URL=postgresql+psycopg://eventapp:eventapp@127.0.0.1:5432/eventapp
ENVIRONMENT=development
AI_ENABLED=false
AI_SYNTHETIC_ONLY=false
AI_SYNTHETIC_EVENT_IDS=[]
# Explicit development real-data opt-in; production calls remain disabled.
AI_REAL_DATA_ENABLED=false
AI_ALLOWED_EVENT_IDS=[]
SOCLAAS_BASE_URL="https://soclaas-api.comp.nus.edu.sg/v1"
SOCLAAS_API_KEY=
SOCLAAS_MODEL="default"
SOCLAAS_REQUESTS_PER_MINUTE=30
